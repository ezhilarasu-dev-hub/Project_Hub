# ===================================================================
# Project Hub - Environment Configuration Template
# ===================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT YOUR REAL .env FILE WITH SECRETS TO VERSION CONTROL!
# ===================================================================

# 1. Groq Cloud AI API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Optional custom Groq endpoint URL:
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# 2. Server Port Configuration
# Default is 8080 (AWS EC2 will reverse-proxy port 80/443 to 8080 via Nginx)
SERVER_PORT=8080

# 3. SQLite Database File Path
# Local development default:
PROJECT_HUB_DB_PATH=./project_hub.db
# AWS Ubuntu EC2 production recommended path:
# PROJECT_HUB_DB_PATH=/var/lib/project-hub/project_hub.db

# 4. Storage & Knowledge Base Paths
# Local development default:
PROJECT_HUB_UPLOAD_DIR=./uploads/projects/
PROJECT_HUB_KNOWLEDGE_FILE=senior_projects.txt
# AWS Ubuntu EC2 production recommended path:
# PROJECT_HUB_UPLOAD_DIR=/var/lib/project-hub/uploads/projects/

# 5. Security Configuration (JWT)
# In production, generate a secure 256-bit secret key
JWT_SECRET=9a3f4b8c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a
JWT_EXPIRATION_MS=86400000
